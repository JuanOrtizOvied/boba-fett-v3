# ECR
ECR_REGISTRY=123456789.dkr.ecr.us-east-1.amazonaws.com
ECR_REPO_FRONTEND=sabbi-web
ECR_REPO_BACKEND=sabbi-backend

# TLS — Let's Encrypt registration email
ACME_EMAIL=sabbi.tecnologia@gmail.com

# Frontend
LANGCHAIN_API_KEY=

# Backend — Anthropic / LangSmith
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
TAVILY_API_KEY=

# Backend — Database
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/sabbi
POSTGRES_URI=postgresql://postgres:postgres@host.docker.internal:5432/sabbi

# Backend — Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
