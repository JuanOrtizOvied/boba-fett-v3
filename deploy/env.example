# ECR
ECR_REGISTRY=123456789.dkr.ecr.us-east-1.amazonaws.com
ECR_REPO_FRONTEND=sabbi-web
ECR_REPO_BACKEND=sabbi-backend

# TLS — Let's Encrypt registration email
ACME_EMAIL=sabbi.tecnologia@gmail.com

# Frontend
LANGCHAIN_API_KEY=

# Backend — Anthropic / LangSmith
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
TAVILY_API_KEY=

# Backend — Database
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/sabbi
POSTGRES_URI=postgresql://postgres:postgres@host.docker.internal:5432/sabbi

# Backend — Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Backend — SharePoint catalog sync (off unless SHAREPOINT_SYNC_ENABLED=true).
# The deploy writes the server .env from AWS Secrets Manager, so every key here
# that the sync needs must also be added to that environment's secret. To turn
# it on, set SHAREPOINT_SYNC_ENABLED=true and fill in all of the AZURE_* keys,
# SHAREPOINT_SITE_ID, SHAREPOINT_FILE_PATH and GRAPH_NOTIFICATION_URL.
# Azure app registration used to read the Excel through Microsoft Graph.
# AZURE_CLIENT_SECRET expires: record its expiry date and rotate it before then.
SHAREPOINT_SYNC_ENABLED=false
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# Site and workbook to sync (not secret). The sheet name must match exactly.
# Find both with: python -m catalog_sync.graph discover --host <tenant>.sharepoint.com
#   --site <site name> --folder <folder> --file <workbook>.xlsx
# SITE_ID looks like host,site-guid,web-guid. FILE_PATH is relative to the document
# library, without its name (e.g. folder/BD_Productos.xlsx).
SHAREPOINT_SITE_ID=
SHAREPOINT_FILE_PATH=
SHAREPOINT_SHEET_NAME=1. Productos (maestra)
# How often the periodic job runs (subscription upkeep plus a safety sync that
# recovers a lost notification), in minutes. Optional, defaults to 360.
SHAREPOINT_SYNC_INTERVAL_MINUTES=360
# Public HTTPS URL Microsoft Graph calls when the workbook changes. It is
# different per environment: each backend registers its own subscription.
GRAPH_NOTIFICATION_URL=https://boba-fett-api.sabbi.com/webhooks/graph/notifications
