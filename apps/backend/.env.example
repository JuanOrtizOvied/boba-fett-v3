# LLM — Claude is the only supported provider.
ANTHROPIC_API_KEY=

# PostgreSQL connection for portfolio data (products table).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sabbi

# PostgreSQL connection for LangGraph checkpoint store.
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/sabbi-langgraph

# Auth — JWT signing secrets and initial admin credentials.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ADMIN_EMAIL=admin@sabbi.com
ADMIN_PASSWORD=admin

# Web search via Tavily (optional — search tools degrade gracefully without it).
TAVILY_API_KEY=

# LangSmith tracing (optional).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sabbi-portfolio-agent

# Integration tests (optional). When unset, integration tests are skipped.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sabbi_test

# Application-level Fernet encryption for sensitive data (amounts, chat messages).
ENCRYPTION_KEY=key

# SharePoint catalog sync (optional, off by default). While
# SHAREPOINT_SYNC_ENABLED is false nothing calls Microsoft Graph, so local
# dev and tests never need the values below. To sync a local file by hand use
# `python -m catalog_sync.local <file.xlsx> [--dry-run]` instead.
SHAREPOINT_SYNC_ENABLED=false
# Azure app registration (never commit real values).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# Site and workbook to sync. The sheet name must match exactly.
# Find both with (from apps/backend/src):
#   python -m catalog_sync.graph discover --host <tenant>.sharepoint.com
#     --site <site name> --folder <folder> --file <workbook>.xlsx
# SITE_ID looks like host,site-guid,web-guid. FILE_PATH is relative to the document
# library, without its name (e.g. folder/BD_Productos.xlsx).
SHAREPOINT_SITE_ID=
SHAREPOINT_FILE_PATH=
SHAREPOINT_SHEET_NAME=1. Productos (maestra)
# Public HTTPS URL Graph calls on changes. localhost is not reachable by
# Microsoft: to test the real webhook locally use a tunnel (e.g. ngrok) and
# put its URL here, ending in /webhooks/graph/notifications.
GRAPH_NOTIFICATION_URL=
