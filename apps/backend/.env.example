# LLM — Claude is the only supported provider.
ANTHROPIC_API_KEY=

# PostgreSQL connection for portfolio data (products table).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sabbi

# PostgreSQL connection for LangGraph checkpoint store.
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/sabbi-langgraph

# Auth — JWT signing secrets and initial admin credentials.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ADMIN_EMAIL=admin@sabbi.com
ADMIN_PASSWORD=admin

# Web search via Tavily (optional — search tools degrade gracefully without it).
TAVILY_API_KEY=

# LangSmith tracing (optional).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sabbi-portfolio-agent

# Integration tests (optional). When unset, integration tests are skipped.
# pytest reads this from the shell environment, not from this file: export it
# before running the suite, or the integration tests are skipped silently.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sabbi_test

# Application-level Fernet encryption for sensitive data (amounts, chat messages).
ENCRYPTION_KEY=key

# SharePoint catalog sync (optional, off by default). While
# SHAREPOINT_SYNC_ENABLED is false nothing calls Microsoft Graph, so local
# dev and tests never need the values below. To sync a local file by hand use
# `python -m catalog_sync.local <file.xlsx> [--dry-run]` instead.
#
# To turn the sync on, set SHAREPOINT_SYNC_ENABLED=true and fill in all of:
# AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET, SHAREPOINT_SITE_ID,
# SHAREPOINT_FILE_PATH and GRAPH_NOTIFICATION_URL. SHAREPOINT_SHEET_NAME and
# SHAREPOINT_SYNC_INTERVAL_MINUTES have defaults. Without
# GRAPH_NOTIFICATION_URL the periodic safety sync still runs, but creating the
# Graph subscription fails on every cycle and edits are only picked up then.
SHAREPOINT_SYNC_ENABLED=false
# Azure app registration (never commit real values).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# Site and workbook to sync. The sheet name must match exactly.
# Find both with (from apps/backend/src):
#   python -m catalog_sync.graph discover --host <tenant>.sharepoint.com
#     --site <site name> --folder <folder> --file <workbook>.xlsx
# SITE_ID looks like host,site-guid,web-guid. FILE_PATH is relative to the document
# library, without its name (e.g. folder/BD_Productos.xlsx).
SHAREPOINT_SITE_ID=
SHAREPOINT_FILE_PATH=
SHAREPOINT_SHEET_NAME=1. Productos (maestra)
# How often the periodic job runs (subscription upkeep plus a safety sync that
# recovers a lost notification), in minutes. Optional, defaults to 360.
SHAREPOINT_SYNC_INTERVAL_MINUTES=360
# Public HTTPS URL Graph calls on changes. localhost is not reachable by
# Microsoft: to test the real webhook locally use a tunnel (Tailscale Funnel,
# ngrok...) and put its URL here, ending in /webhooks/graph/notifications.
# The tunnel must forward to the FastAPI backend (port 3003), not to Next.js,
# and its hostname must already resolve to a public address: Graph rejects the
# subscription with "No such host is known" until it does. Start the tunnel
# before the backend, because the subscription is created about 30 seconds
# after startup. Stop the tunnel when you are done testing.
GRAPH_NOTIFICATION_URL=

# SharePoint catalog sync v2 (optional, off by default). v2 is its own sync, with
# its own workbook, subscription, webhook and flag, so it can be on or off
# independently of the one above. While SHAREPOINT_V2_SYNC_ENABLED is false nothing
# calls Microsoft Graph. To sync a local file by hand use
# `python -m catalog_v2.local <file.xlsx> [--dry-run]` instead.
#
# v2 reuses AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET, SHAREPOINT_SITE_ID
# and SHAREPOINT_SYNC_INTERVAL_MINUTES from the block above, so fill those in too. To
# turn v2 on, set SHAREPOINT_V2_SYNC_ENABLED=true and fill in SHAREPOINT_V2_FILE_PATH
# and GRAPH_V2_NOTIFICATION_URL. Without GRAPH_V2_NOTIFICATION_URL the periodic safety
# sync still runs, but creating the Graph subscription fails on every cycle and edits
# are only picked up then. POST /admin/catalog-v2/sync/run syncs on demand.
SHAREPOINT_V2_SYNC_ENABLED=false
# Workbook of v2, relative to the document library, without its name (e.g.
# folder/BD_Productos_v2.xlsx). The sheet names are fixed in the code. The site and
# the path can be found with the `discover` command of the block above.
SHAREPOINT_V2_FILE_PATH=
# Public HTTPS URL Graph calls when the v2 workbook changes, ending in
# /webhooks/graph-v2/notifications. The same notes as GRAPH_NOTIFICATION_URL apply:
# localhost is not reachable by Microsoft, so use a tunnel to the FastAPI backend
# (port 3003) that already resolves to a public address, start it before the backend,
# and stop it when you are done testing.
GRAPH_V2_NOTIFICATION_URL=
